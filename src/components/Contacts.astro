---
import Photo from "./Photo.astro";
import Icon from "./Icon.astro";
import { contacts } from "../data/clinic";
---
<section id="kontakty" class="section" data-rec="R-103,R-106,S-R007,S-R008" aria-labelledby="kontakty-title">
  <div class="container contacts">
    <Photo
      class="contacts__photo"
      name="reception"
      widths={[480, 1047]}
      w={1047}
      h={488}
      alt="Рецепція клініки: стійка адміністратора і логотип BARANOVSKYI на стіні"
      sizes="(min-width: 1024px) 56vw, 92vw"
      caption="Так виглядає рецепція клініки"
    />
    <div class="contacts__info">
      <h2 id="kontakty-title">Вулиця Тихого, 9, центр Ужгорода</h2>
      <p class="contacts__addr">м. Ужгород, {contacts.street}<br /><a class="text-link" href={contacts.map} target="_blank" rel="noopener">Прокласти маршрут на карті</a></p>
      <a class="contacts__phone" href={contacts.phoneHref}><Icon name="phone" size={30} />{contacts.phoneDisplay}</a>
      <div class="contacts__row">
        <a class="btn" href={contacts.booking} target="_blank" rel="noopener"><Icon name="calendar" />Записатися онлайн</a>
      </div>
      <div class="contacts__row">
        <a class="chip" href={contacts.viber}><Icon name="viber" />Написати у Viber</a>
        <a class="chip" href={contacts.telegram} target="_blank" rel="noopener"><Icon name="telegram" />Написати в Telegram</a>
      </div>
      <p class="contacts__social" data-rec="R-106">
        <a class="text-link" href={contacts.instagram} target="_blank" rel="noopener">Instagram</a>
        <a class="text-link" href={contacts.facebook} target="_blank" rel="noopener">Facebook</a>
      </p>
    </div>
  </div>
</section>
